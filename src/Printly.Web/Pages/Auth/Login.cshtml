@page
@model Printly.Web.Pages.Auth.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Printly</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">

<div class="card shadow-sm p-4" style="max-width: 400px; width: 100%;">
    <div class="text-center mb-4">
        <h1 class="h3 mb-1 fw-bold">🖨️ Printly</h1>
        <p class="text-muted small">Sign in to manage your assignments</p>
    </div>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Email address</label>
            <input type="email" name="Email" class="form-control" placeholder="name@student.edu" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="Password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </button>
    </form>

    <hr class="my-3" />
    <p class="text-center small text-muted mb-0">
        No account? <a href="/auth/register">Register with a join code</a>
    </p>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/printly.js"></script>
</body>
</html>
