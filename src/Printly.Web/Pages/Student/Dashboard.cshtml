@page
@model StudentDashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <!-- Stats row -->
    <div class="col-md-3">
        <div class="card text-center p-3">
            <i class="bi bi-files fs-2 text-primary"></i>
            <h3 class="mt-2 mb-0">@Model.TotalFiles</h3>
            <small class="text-muted">Total Files</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <i class="bi bi-hourglass-split fs-2 text-warning"></i>
            <h3 class="mt-2 mb-0">@Model.QueuedFiles</h3>
            <small class="text-muted">In Queue</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <i class="bi bi-printer fs-2 text-info"></i>
            <h3 class="mt-2 mb-0">@Model.PrintingFiles</h3>
            <small class="text-muted">Printing Now</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <i class="bi bi-check-circle fs-2 text-success"></i>
            <h3 class="mt-2 mb-0">@Model.DoneFiles</h3>
            <small class="text-muted">Done</small>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <!-- Recent files -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2"></i>Recent Files</span>
                <a href="/student/upload" class="btn btn-sm btn-primary">
                    <i class="bi bi-upload me-1"></i>Upload
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentFiles.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-folder-x fs-1"></i>
                        <p class="mt-2">No files uploaded yet</p>
                        <a href="/student/upload" class="btn btn-primary btn-sm">Upload your first file</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>File</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th>Price</th>
                                    <th>Queue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.RecentFiles)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-file-earmark me-1 text-primary"></i>
                                            <span class="text-truncate" style="max-width:200px; display:inline-block;">
                                                @file.OriginalFileName
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-@file.Status.ToLower()">
                                                @file.Status
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-@file.PaymentStatus.ToLower()">
                                                @file.PaymentStatus
                                            </span>
                                        </td>
                                        <td>GHS @file.Price.ToString("F2")</td>
                                        <td>
                                            @if (file.QueuePosition.HasValue)
                                            {
                                                <span class="text-muted">#@file.QueuePosition</span>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Notifications panel -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bell me-2"></i>Notifications
            </div>
            <div class="card-body p-0">
                @if (!Model.Notifications.Any())
                {
                    <p class="text-muted text-center py-4 small">No notifications yet</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var n in Model.Notifications.Take(5))
                        {
                            <li class="list-group-item bg-transparent border-secondary
                                       @(!n.IsRead ? "border-start border-3 border-primary" : "")">
                                <div class="d-flex justify-content-between">
                                    <strong class="small">@n.Title</strong>
                                    <small class="text-muted">
                                        @n.CreatedAt.ToString("MMM d")
                                    </small>
                                </div>
                                <p class="small text-muted mb-0">@n.Message</p>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
