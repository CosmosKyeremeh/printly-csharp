@page
@model StudentPaymentsModel
@{
    ViewData["Title"] = "Payments";
}

<h4 class="mb-4"><i class="bi bi-credit-card me-2 text-primary"></i>Payment History</h4>

@if (!Model.Payments.Any())
{
    <div class="card text-center py-5 text-muted">
        <i class="bi bi-receipt fs-1"></i>
        <p class="mt-2">No payments yet</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>@p.FileName</td>
                            <td>GHS @p.Amount.ToString("F2")</td>
                            <td>
                                <i class="bi bi-@(p.Method == "MoMo" ? "phone" : "cash") me-1"></i>@p.Method
                            </td>
                            <td><span class="badge badge-@p.Status.ToLower()">@p.Status</span></td>
                            <td><small class="text-muted">@p.CreatedAt.ToString("MMM d, yyyy")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
