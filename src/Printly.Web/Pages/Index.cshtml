@page
@{
    Layout = null;
    // Redirect logged-in users automatically
    if (User.Identity?.IsAuthenticated == true)
    {
        if (User.IsInRole("Admin") || User.IsInRole("Superadmin"))
            Response.Redirect("/admin/dashboard");
        else
            Response.Redirect("/student/dashboard");
    }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Printly — University Print Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/printly.css" />
</head>
<body class="d-flex flex-column min-vh-100">

<main class="flex-grow-1 d-flex align-items-center justify-content-center">
    <div class="text-center px-3" style="max-width: 640px;">
        <i class="bi bi-printer-fill text-primary" style="font-size: 4rem;"></i>
        <h1 class="fw-bold mt-3 mb-2">Printly</h1>
        <p class="text-muted fs-5 mb-4">
            Centralized assignment pipeline and print management
            for university networks.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/auth/login" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </a>
            <a href="/auth/register" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-person-plus me-2"></i>Register
            </a>
        </div>
        <div class="row g-3 mt-5 text-start">
            <div class="col-md-4">
                <div class="card p-3 h-100">
                    <i class="bi bi-upload text-primary fs-4"></i>
                    <h6 class="mt-2">Upload</h6>
                    <small class="text-muted">Submit files from any device. Track queue position live.</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 h-100">
                    <i class="bi bi-list-check text-warning fs-4"></i>
                    <h6 class="mt-2">Queue</h6>
                    <small class="text-muted">Admins manage the print queue with one-tap status updates.</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 h-100">
                    <i class="bi bi-phone text-success fs-4"></i>
                    <h6 class="mt-2">Pay</h6>
                    <small class="text-muted">Pay via MTN MoMo or cash. Receipts sent automatically.</small>
                </div>
            </div>
        </div>
    </div>
</main>

<footer class="text-center py-3 text-muted small border-top border-secondary">
    Printly · Built with ASP.NET Core 10 · By BonGr8
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
