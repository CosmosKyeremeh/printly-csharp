@page
@model AdminQueueModel
@{
    ViewData["Title"] = "Print Queue";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-list-ol me-2 text-primary"></i>Print Queue</h4>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width:auto"
                onchange="filterQueue(this.value)">
            <option value="">All Statuses</option>
            <option value="Queued">Queued</option>
            <option value="Printing">Printing</option>
            <option value="Done">Done</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <button class="btn btn-sm btn-warning" onclick="bulkUpdate('Printing')">
            <i class="bi bi-printer me-1"></i>Mark Printing
        </button>
        <button class="btn btn-sm btn-success" onclick="bulkUpdate('Done')">
            <i class="bi bi-check-lg me-1"></i>Mark Done
        </button>
    </div>
</div>

@if (!Model.QueueItems.Any())
{
    <div class="card text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-3">The print queue is empty</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAll"
                                   onchange="toggleAll(this)" /></th>
                        <th>File</th>
                        <th>Student</th>
                        <th>Category</th>
                        <th>Pages</th>
                        <th>Price (GHS)</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Queued</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.QueueItems)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="row-check"
                                       value="@item.FileRecordId" />
                            </td>
                            <td>
                                <i class="bi bi-file-earmark text-primary me-1"></i>
                                <span style="max-width:180px; display:inline-block;"
                                      class="text-truncate" title="@item.FileName">
                                    @item.FileName
                                </span>
                                @if (!string.IsNullOrEmpty(item.PrintingInstructions))
                                {
                                    <i class="bi bi-chat-left-text text-warning ms-1"
                                       title="@item.PrintingInstructions"></i>
                                }
                            </td>
                            <td>
                                <div>@item.UploaderName</div>
                                @if (!string.IsNullOrEmpty(item.UploaderWhatsApp))
                                {
                                    <a href="https://wa.me/@(item.UploaderWhatsApp!.Replace("+",""))"
                                       class="badge bg-success text-decoration-none"
                                       target="_blank">
                                        <i class="bi bi-whatsapp"></i> WhatsApp
                                    </a>
                                }
                            </td>
                            <td><span class="text-muted small">@(item.CategoryName ?? "—")</span></td>
                            <td>@(item.PageCount?.ToString() ?? "—")</td>
                            <td>
                                <div class="input-group input-group-sm" style="width:110px">
                                    <span class="input-group-text bg-dark border-secondary">₵</span>
                                    <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                                           value="@item.Price.ToString("F2")"
                                           onchange="setPrice('@item.FileRecordId', this.value)"
                                           step="0.50" min="0"
                                           @(item.PriceLocked ? "disabled" : "") />
                                </div>
                                @if (item.PriceLocked)
                                {
                                    <i class="bi bi-lock-fill text-warning small ms-1"></i>
                                }
                            </td>
                            <td>
                                <span class="badge badge-@item.PaymentStatus.ToLower()">
                                    @item.PaymentStatus
                                </span>
                                @if (item.PaymentStatus != "Paid")
                                {
                                    <button class="btn btn-xs btn-outline-success ms-1"
                                            onclick="markCashPaid('@item.FileRecordId')"
                                            title="Mark as cash paid">
                                        <i class="bi bi-cash"></i>
                                    </button>
                                }
                            </td>
                            <td>
                                <span class="badge badge-@item.Status.ToLower()">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @item.QueuedAt.ToString("MMM d, HH:mm")
                                </small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Queued")
                                    {
                                        <button class="btn btn-outline-warning"
                                                onclick="updateStatus('@item.FileRecordId', 'Printing')">
                                            <i class="bi bi-printer"></i>
                                        </button>
                                    }
                                    @if (item.Status == "Printing")
                                    {
                                        <button class="btn btn-outline-success"
                                                onclick="updateStatus('@item.FileRecordId', 'Done')">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                    @if (item.Status != "Done" && item.Status != "Cancelled")
                                    {
                                        <button class="btn btn-outline-danger"
                                                onclick="updateStatus('@item.FileRecordId', 'Cancelled')">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
const token = sessionStorage.getItem("printly_token")
           || document.cookie.split('; ').find(r => r.startsWith('printly_token='))?.split('=')[1];

async function apiCall(url, method, body) {
    const res = await fetch(url, {
        method,
        headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${token}`
        },
        body: body ? JSON.stringify(body) : null
    });
    return res;
}

async function updateStatus(fileId, status) {
    const res = await apiCall(`/api/queue/${fileId}/status`, "PATCH", { status });
    if (res.ok) location.reload();
    else alert("Failed to update status");
}

async function setPrice(fileId, price) {
    await apiCall(`/api/queue/${fileId}/price`, "PATCH", { price: parseFloat(price) });
}

async function markCashPaid(fileId) {
    const res = await apiCall(`/api/payments/${fileId}/cash`, "PATCH");
    if (res.ok) location.reload();
    else alert("Failed to mark as paid");
}

function toggleAll(cb) {
    document.querySelectorAll(".row-check").forEach(c => c.checked = cb.checked);
}

async function bulkUpdate(status) {
    const ids = [...document.querySelectorAll(".row-check:checked")].map(c => c.value);
    if (!ids.length) { alert("Select at least one file"); return; }
    const res = await apiCall("/api/queue/bulk-status", "PATCH", { fileIds: ids, status });
    if (res.ok) location.reload();
    else alert("Bulk update failed");
}

function filterQueue(status) {
    const url = status ? `?status=${status}` : window.location.pathname;
    window.location.href = url;
}
</script>
}

